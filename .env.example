# Flask settings
FLASK_ENV=production
FLASK_DEBUG=0

# App Security
# Use strong random values — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-32-plus-char-secret
JWT_SECRET_KEY=replace-with-a-different-random-32-plus-char-secret

# Database — provided automatically by Render PostgreSQL add-on
DATABASE_URL=postgresql://user:password@host:5432/dbname

# CORS — set to your deployed frontend URL (e.g. Render static site or custom domain)
# Separate multiple origins with commas
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com

# Cookie security (keep true in production)
SESSION_COOKIE_SECURE=true
JWT_COOKIE_SECURE=true

# AI Provider API Keys
# Get your OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Get your Anthropic key from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Default AI provider (openai or anthropic)
DEFAULT_AI_PROVIDER=openai

# AI Models
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
